# ---------------------------------------------------------------------------
# PES Online Evolution - environment template
# Copy to .env (make env) and adjust locally. Never commit .env.
# ---------------------------------------------------------------------------

# Core
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_USER=pes
POSTGRES_PASSWORD=pes_dev_password
POSTGRES_DB=pes_online
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://pes:pes_dev_password@localhost:5432/pes_online

# Authentication
JWT_SECRET=dev-only-change-me-4f8c2b1e9a7d6c5b3e2f1a0d9c8b7a6e
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Backblaze B2 (required from Phase 14; empty in local dev)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=pes-online-assets
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Companion app
COMPANION_WS_URL=ws://localhost:8000/ws